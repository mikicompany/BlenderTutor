# PUBLIC BUILD CONFIG — NOT A SECRET STORE.
#
# Vite inlines every VITE_* variable into the browser bundle at build time, so
# everything in this file is readable by anyone who opens DevTools on the live
# site. Committing it changes nothing about that: the values are public the
# moment the site ships, whether or not this file is in git.
#
# Real secrets go in GitHub Actions secrets instead, the way MAILCHIMP_API_KEY
# does for scripts/radar-email.js — that one is never inlined because it is
# used by a workflow, not by the browser.
#
# Before adding anything here, ask: would it be fine printed on the home page?
# If not, it does not belong in this file.

# The Radar's default RAWG key. Public by necessity — the browser calls RAWG
# directly, so the key has to travel with the page. A visitor can override it
# with their own via The Radar's key button, and Radar.jsx falls back to this
# one if a stored key is rejected.
VITE_RAWG_API_KEY=399bb966afe54311872eabd9a7681ee2

# Where booking-link clicks are sent so they arrive as an email. Anything that
# turns an HTTP POST into a message works — a Formsubmit alias, a Web3Forms
# endpoint, a Zapier catch hook. The click is sent form-encoded, so each field
# becomes a line of the email.
#
# Use an endpoint that is harmless if strangers find it, and never put a secret
# in it.
#
# Note the site is built locally and docs/ is committed — the deploy workflow
# only uploads that folder — so changing this needs a rebuild to take effect.
VITE_BOOKING_WEBHOOK=https://formsubmit.co/dg1company@gmail.com
